# NEXUS OS boot splash (plymouth "script" plugin). The desktop shell starts with the same picture in the same
# place (shell/Intro.qml) and fades it out, so boot -> desktop reads as one movement.
Window.SetBackgroundTopColor(0.024, 0.027, 0.051);      # #06070d
Window.SetBackgroundBottomColor(0.035, 0.039, 0.086);   # #090a16

cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

mark.image = Image("mark.png");                          # 240 px canvas, the mark centred in it
mark.sprite = Sprite(mark.image);
mark.sprite.SetPosition(cx - mark.image.GetWidth() / 2, cy - 40 - mark.image.GetHeight() / 2, 1);

word.image = Image("word.png");
word.sprite = Sprite(word.image);
word.sprite.SetPosition(cx - word.image.GetWidth() / 2, cy + 26, 1);

dot.image = Image("dot.png");
for (i = 0; i < 3; i++) {
  dots[i] = Sprite(dot.image);
  dots[i].SetPosition(cx - 4 + (i - 1) * 20, cy + 100, 1);
  dots[i].SetOpacity(0.25);
}

frame = 0;
fun refresh () {
  frame++;                                               # called 50 times a second
  mark.sprite.SetOpacity(0.93 + 0.07 * Math.Sin(frame / 25));
  for (i = 0; i < 3; i++) {
    w = Math.Sin(frame / 8 - i * 0.9);
    if (w < 0) w = 0;
    dots[i].SetOpacity(0.25 + 0.75 * w);
  }
}
Plymouth.SetRefreshFunction(refresh);
