# NEXUS window theme for labwc
border.width: 1
padding.height: 8
window.active.border.color: #2a2f45
window.inactive.border.color: #1d2133
window.active.title.bg.color: #161a29
window.inactive.title.bg.color: #11141f
window.active.label.text.color: #e8ebff
window.inactive.label.text.color: #7d84a3
window.label.text.justify: center
window.active.button.unpressed.image.color: #c9cdf0
window.inactive.button.unpressed.image.color: #5b6180
window.active.button.hover.bg.color: #2a2f45
window.button.width: 28
window.button.spacing: 4
window.button.hover.bg.corner-radius: 6
menu.items.bg.color: #161a29
menu.items.text.color: #e8ebff
menu.items.active.bg.color: #7c6cff
menu.items.active.text.color: #ffffff
menu.border.color: #2a2f45
menu.border.width: 1
# the title-bar menu: roomier rows and a quiet separator
menu.items.padding.x: 14
menu.items.padding.y: 7
menu.width.min: 210
menu.separator.width: 1
menu.separator.padding.width: 10
menu.separator.padding.height: 4
menu.separator.color: #2a2f45
osd.bg.color: #161a29
osd.border.color: #2a2f45
osd.label.text.color: #e8ebff
osd.border.width: 1
# Alt+Tab
osd.window-switcher.width: 380
osd.window-switcher.padding: 10
osd.window-switcher.item.padding.x: 16
osd.window-switcher.item.padding.y: 9
osd.window-switcher.item.active.border.width: 2
osd.window-switcher.preview.border.width: 3
osd.window-switcher.preview.border.color: #7c6cff
window.active.shadow.size: 28
window.inactive.shadow.size: 14
window.active.shadow.color: #00000080
window.inactive.shadow.color: #00000050
# dragging a window to an edge: where it will land, in the accent colour (like Windows' snap preview)
snapping.overlay.region.bg.enabled: yes
snapping.overlay.edge.bg.enabled: yes
snapping.overlay.region.bg.color: #7c6cff2e
snapping.overlay.edge.bg.color: #7c6cff2e
snapping.overlay.region.border.enabled: yes
snapping.overlay.edge.border.enabled: yes
snapping.overlay.region.border.width: 2
snapping.overlay.edge.border.width: 2
snapping.overlay.region.border.color: #7c6cffcc
snapping.overlay.edge.border.color: #7c6cffcc
