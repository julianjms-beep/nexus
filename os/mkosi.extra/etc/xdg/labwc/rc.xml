<?xml version="1.0"?>
<!-- NEXUS OS window manager settings (labwc). Users can override in ~/.config/labwc/rc.xml -->
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>8</gap>
    <adaptiveSync>no</adaptiveSync>
  </core>
  <placement><policy>cascade</policy></placement>
  <theme>
    <name>NEXUS</name>
    <cornerRadius>10</cornerRadius>
    <!-- no window-menu icon on the left (Qt apps without a desktop file get a generic one): just the title and the buttons -->
    <titlebar><layout>:iconify,max,close</layout><showTitle>yes</showTitle></titlebar>
    <dropShadows>yes</dropShadows>
    <font place="ActiveWindow"><name>Inter</name><size>10</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>Inter</name><size>10</size><weight>bold</weight></font>
    <font place="MenuItem"><name>Inter</name><size>10</size></font>
    <font place="OnScreenDisplay"><name>Inter</name><size>12</size></font>
  </theme>
  <!-- Alt+Tab: only the window names, in the NEXUS style (labwc 0.8 has no app icons in the switcher, and the
       default fields read like "[xdg-shell] qml Archivos"); the previewed window gets an accent outline (themerc) -->
  <windowSwitcher show="yes" preview="yes" outlines="yes" allWorkspaces="no">
    <fields>
      <field content="title" width="100%" />
    </fields>
  </windowSwitcher>
  <!-- four virtual desktops (Súper+1…4, Súper+Ctrl+flechas; Súper+Tab shows every window and desktop). labwc's own
       switcher popup stays off: the NEXUS shell shows the desktops itself (shell/Overview.qml) -->
  <desktops>
    <popupTime>0</popupTime>
    <names><name>1</name><name>2</name><name>3</name><name>4</name></names>
  </desktops>
  <keyboard>
    <default />
    <!-- hidden keys nexus-sessiond presses (wtype) so the compositor does the switching itself: never on a keyboard -->
    <keybind key="XF86Launch5"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="XF86Launch6"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="XF86Launch7"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="XF86Launch8"><action name="GoToDesktop" to="4" /></keybind>
    <keybind key="XF86LaunchA"><action name="SendToDesktop" to="1" follow="no" /></keybind>
    <keybind key="XF86LaunchB"><action name="SendToDesktop" to="2" follow="no" /></keybind>
    <keybind key="XF86LaunchC"><action name="SendToDesktop" to="3" follow="no" /></keybind>
    <keybind key="XF86LaunchD"><action name="SendToDesktop" to="4" follow="no" /></keybind>
    <!-- the person's keys go through nexus-sessiond, which keeps the book of desktops and windows -->
    <keybind key="W-1"><action name="Execute" command="nexusctl desktop 1" /></keybind>
    <keybind key="W-2"><action name="Execute" command="nexusctl desktop 2" /></keybind>
    <keybind key="W-3"><action name="Execute" command="nexusctl desktop 3" /></keybind>
    <keybind key="W-4"><action name="Execute" command="nexusctl desktop 4" /></keybind>
    <keybind key="W-C-Left"><action name="Execute" command="nexusctl desktop left" /></keybind>
    <keybind key="W-C-Right"><action name="Execute" command="nexusctl desktop right" /></keybind>
    <keybind key="W-S-1"><action name="Execute" command="nexusctl move 1" /></keybind>
    <keybind key="W-S-2"><action name="Execute" command="nexusctl move 2" /></keybind>
    <keybind key="W-S-3"><action name="Execute" command="nexusctl move 3" /></keybind>
    <keybind key="W-S-4"><action name="Execute" command="nexusctl move 4" /></keybind>
    <keybind key="W-space"><action name="Execute" command="nexusctl ui ai" /></keybind>
    <keybind key="A-space"><action name="Execute" command="nexusctl ui ai" /></keybind>
    <!-- Apple keyboards: Option is AltGr there (nexus-session), so Option+Space, Option+Tab and Cmd+Tab are bound too -->
    <keybind key="M-space"><action name="Execute" command="nexusctl ui ai" /></keybind>
    <keybind key="M-Tab"><action name="NextWindow" /></keybind>
    <keybind key="M-S-Tab"><action name="PreviousWindow" /></keybind>
    <keybind key="W-Tab"><action name="Execute" command="nexusctl ui overview" /></keybind>
    <keybind key="W-S-Tab"><action name="PreviousWindow" /></keybind>
    <keybind key="W-Return"><action name="Execute" command="nexus-terminal" /></keybind>
    <keybind key="W-e"><action name="Execute" command="nexusctl open files" /></keybind>
    <keybind key="W-n"><action name="Execute" command="nexusctl ui center" /></keybind>
    <keybind key="W-l"><action name="Execute" command="nexus-lock" /></keybind>
    <keybind key="W-q"><action name="Close" /></keybind>
    <!-- ⌘C ⌘V ⌘X ⌘A ⌘Z ⌘⇧Z like on a Mac (usr/bin/nexus-editkey sends the Ctrl shortcut; Ctrl+Shift in the terminal) -->
    <keybind key="W-c"><action name="Execute" command="nexus-editkey c" /></keybind>
    <keybind key="W-v"><action name="Execute" command="nexus-editkey v" /></keybind>
    <keybind key="W-x"><action name="Execute" command="nexus-editkey x" /></keybind>
    <keybind key="W-a"><action name="Execute" command="nexus-editkey a" /></keybind>
    <keybind key="W-z"><action name="Execute" command="nexus-editkey z" /></keybind>
    <keybind key="W-S-z"><action name="Execute" command="nexus-editkey Z" /></keybind>
    <keybind key="W-Up"><action name="ToggleMaximize" /></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" /></keybind>
    <keybind key="Print"><action name="Execute" command="sh -c 'mkdir -p ~/Imágenes &amp;&amp; grim ~/Imágenes/captura-$(date +%Y%m%d-%H%M%S).png'" /></keybind>
  </keyboard>
  <mouse><default /></mouse>
  <libinput><device category="default"><naturalScroll>no</naturalScroll><tap>yes</tap></device></libinput>
  <windowRules>
    <windowRule identifier="foot" serverDecoration="yes" />
  </windowRules>
</labwc_config>
